# API-ключ команды (получите на app.ai-business-spb.ru)
API_KEY=your-team-api-key

# MSSQL (локальный Docker)
MSSQL_SA_PASSWORD=YourStrong!Pass123
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=service_desk_tdbb
MSSQL_USER=SA

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=service_desk_knowledge
QDRANT_TIMEOUT_SECONDS=30

# YandexGPT
YANDEX_GPT_API_KEY=your-api-key
YANDEX_GPT_FOLDER_ID=your-folder-id
YANDEX_GPT_MODEL=yandexgpt/latest
YANDEX_EMBEDDING_DOC_MODEL=text-search-doc/latest
YANDEX_EMBEDDING_QUERY_MODEL=text-search-query/latest
YANDEX_GPT_TIMEOUT_SECONDS=30
YANDEX_GPT_TEMPERATURE=0.2
YANDEX_GPT_MAX_TOKENS=800
YANDEX_GPT_SYSTEM_PROMPT=Ты support-ассистент компании Балтийский Берег. Отвечай только на основе предоставленного контекста и не выдумывай факты.

# RAG
RAG_ENABLED=true
RAG_TICKET_MAX_CHARS=6000
RAG_KB_CHUNK_SIZE_CHARS=1800
RAG_KB_CHUNK_OVERLAP_CHARS=250
RAG_RETRIEVAL_LIMIT=24
RAG_RERANK_LIMIT=8
RAG_MIN_VECTOR_SCORE=0.15
RAG_MIN_RERANK_SCORE=0.45
RAG_MIN_FINAL_CONFIDENCE=0.7
RAG_SYNC_ON_STARTUP=true
RAG_SYNC_INTERVAL_SECONDS=1800
RAG_SYNC_BATCH_SIZE=200
RAG_SYNC_STATE_PATH=data/rag-sync-state.json

# Telegram
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Frontend
FRONTEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# FastAPI / app
APP_NAME=Baltiyskiy Bereg Bot API
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
LOG_LEVEL=INFO
