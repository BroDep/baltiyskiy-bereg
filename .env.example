# API-ключ команды (получите на app.ai-business-spb.ru)
API_KEY=your-team-api-key

# MSSQL (локальный Docker)
MSSQL_SA_PASSWORD=YourStrong!Pass123
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=service_desk_tdbb
MSSQL_USER=SA

# YandexGPT
YANDEX_GPT_API_KEY=your-api-key
YANDEX_GPT_FOLDER_ID=your-folder-id
YANDEX_GPT_MODEL=yandexgpt/latest
YANDEX_GPT_BASE_URL=https://llm.api.cloud.yandex.net

# Runtime settings storage
SETTINGS_DATABASE_PATH=data/runtime/settings.sqlite3
DEFAULT_SYSTEM_PROMPT=Ты внутренний ассистент сервис-деска Балтийский Берег.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=30

# RAG pipeline
QDRANT_URL=http://localhost:6333
ESCALATION_THRESHOLD=7

# Frontend → Backend URL
API_BASE_URL=http://localhost:8000

# Set to true to return stub responses (use while RAG pipeline is not ready)
USE_STUBS=true

# Remote LLM backend (routes.py API, set USE_STUBS=false to enable)
REMOTE_API_URL=http://111.88.159.116
